{
  "name": "cursor-agents-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that delegates work to Cursor SDK agents as reusable, inspectable, detached background jobs.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
