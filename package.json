    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
